<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>MvnG</groupId>
    <artifactId>ExactLearner</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>
    <name>ExactLearner</name>
    <url>https://maven.apache.org</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.7.0</version>
                <configuration>
                    <!--
                      The oldest Java that can run the classes, not the build JDK
                      (21, see .sdkmanrc). 17 so a local `java` 17 can run them;
                      they still run on the cluster's 21. `release` also fails the
                      build on any post-17 API call.
                    -->
                    <release>17</release>
                    <excludes>
                        <!--
                          Opening a .java file in JupyterLab leaves a copy under
                          .ipynb_checkpoints/, which the compiler then sees as a
                          second declaration of the same public class and fails
                          the build outright. The directory is gitignored, so it
                          never appears in a diff and never reproduces on another
                          machine, which makes the failure look like the pull
                          broke something. Excluding it here is the only fix that
                          survives someone opening the file again.
                        -->
                        <exclude>**/.ipynb_checkpoints/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <!-- ======================== Dependencies ======================== -->

    <!-- What each dependency is for. After changing this section, regenerate
         cp.txt on a login node (the job runs java -cp target/classes:cp.txt):
           mvn dependency:build-classpath -Dmdep.outputFile=cp.txt
         Check that a removal compiles is not enough: a direct dependency can
         also be what pins a version for OWL API's own libraries (see the
         version pins below), so compare the classpath before and after. -->
    <dependencies>

        <!-- ==================== Ontologies and reasoning ==================== -->

        <!-- ELK, the EL reasoner behind ELEngine (the hypothesis, and the target
             in LaunchExactLearner), the evaluation and PacloDataset. It also
             brings in OWL API 5.1.20, which all ontology code uses. -->
        <dependency>
            <groupId>io.github.liveontologies</groupId>
            <artifactId>elk-owlapi</artifactId>
            <version>0.6.0</version>
        </dependency>

        <!-- ======================= Configs and cache ======================== -->

        <!-- Reads the YAML experiment configs into Configuration. -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.2</version>
        </dependency>

        <!-- The query cache: cache.sqlite3. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.0</version>
        </dependency>

        <!-- ============================ Logging ============================= -->

        <!-- The launchers and some tests call log4j's LogManager to turn the
             OWL API/ELK logging down. -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.24.3</version>
        </dependency>

        <!-- ============================= Tests ============================== -->

        <!-- JUnit 5. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <!-- Pinned, not RELEASE: RELEASE makes Maven re-fetch
                 maven-metadata.xml from central on every build, so the build
                 cannot run offline (-o), and it had already drifted across 6.0.2,
                 6.1.2 and 6.1.3 in one local repository. 6.1.2 chosen because it
                 is the newest already present in both the cluster's ~/.m2 and a
                 local one, so `mvn -o` needs no download. Test scope only, and
                 the cluster always builds -DskipTests, so the version is
                 immaterial to the learner. -->
            <version>6.1.2</version>
            <scope>test</scope>
        </dependency>

        <!-- Matchers for assertThat() in the tests. -->
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest</artifactId>
            <version>3.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest-library</artifactId>
            <version>3.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- ========================== Version pins ========================== -->

    <!-- Not dependencies of ours: versions for libraries OWL API's RDF parsers
         bring in. Each was once set by a direct dependency we have since
         removed (Jena, jackson-databind); without the pins Maven falls back
         to older releases (commons-codec 1.11, jcl-over-slf4j 1.7.29,
         Jackson 2.10.1/2.11.4). -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>commons-codec</groupId>
                <artifactId>commons-codec</artifactId>
                <version>1.16.1</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>jcl-over-slf4j</artifactId>
                <version>2.0.7</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>2.13.0</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>2.13.0</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-annotations</artifactId>
                <version>2.13.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
