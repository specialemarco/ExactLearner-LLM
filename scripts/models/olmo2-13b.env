# OLMo-2-1124-13B-Instruct.

MODEL_DIR="OLMo-2-1124-13B-Instruct"
# Hugging Face repository for scripts/fetch_model.sh.
HF_REPO="allenai/OLMo-2-1124-13B-Instruct"
MODEL_NAME="olmo-2-13b"

# ~25.5 GiB of weights leaves ~10 GiB of KV pool on one 40 GB card, and full MHA
# (40 KV heads, no GQA) costs ~800 KB/token, ~4x deepseek-r1-14b. 40 heads divide by 2.
TENSOR_PARALLEL=2
GPUS=2

# Not a reasoning model: no <think> budget needed, as with mistral.
MAX_NEW_TOKENS=512

# Not measured.
EXACTLEARNER_BATCH_SIZE=32

# A smoke-test default; a full run needs far longer.
WALLTIME="${WALLTIME:-12:00:00}"
MEMORY="128G"   # the standard; the Java heap is derived from it (run_experiment.sh)
