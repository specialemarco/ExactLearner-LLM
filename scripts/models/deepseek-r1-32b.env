# DeepSeek-R1-Distill-Qwen-32B.
#
# A reasoning model: its chat template opens <think>, so an answer costs
# hundreds of tokens and MAX_NEW_TOKENS is a correctness setting, not a speed
# one -- a query that hits the cap silently flips True to False. At a 512 cap
# the measured p95 was 493, hence 1024. Watch at_cap in the log, not truncated.
#
# TENSOR_PARALLEL must equal the GPU count and divide the attention head count.
MODEL_DIR="hub/models--deepseek-ai--DeepSeek-R1-Distill-Qwen-32B/snapshots/711ad2ea6aa40cfca18895e8aca02ab92df1a746"
MODEL_NAME="deepseek-r1-32b"
TENSOR_PARALLEL=4
GPUS="a100:4"
MAX_NEW_TOKENS=1024
EXACTLEARNER_BATCH_SIZE=16
