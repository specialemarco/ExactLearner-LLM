# A reasoning model: its chat template opens <think>.
MAX_NEW_TOKENS=1024

# Not measured.
EXACTLEARNER_BATCH_SIZE=32

WALLTIME="${WALLTIME:-06:00:00}"
# 24g ran out on C2 (Olivia job 2419580): the hypothesis reached 66k axioms, and the
# learner spent its last 33 minutes in GC with the GPU idle. Job peak was 32 GiB.
MEMORY="96G"
JAVA_HEAP="64g"
