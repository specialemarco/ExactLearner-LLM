# Hugging Face repository for scripts/fetch_model.sh.
HF_REPO="deepseek-ai/DeepSeek-R1-Distill-Qwen-1.5B"
HF_REVISION="ad9f0ae0864d7fbcd1cd905e3c6c5b069cc8b562"
MODEL_NAME="deepseekQwen-1.5b"

# 3.3 GiB of weights, 2 KV heads (~28 KB/token of KV cache):
# at most 20 GiB of weights per 40 GB card.
TENSOR_PARALLEL=1
