# allenai/Olmo-3-7B-Think, generated by scripts/fetch_model.sh on 2026-10-04.
# Review the settings below before a real run.

MODEL_DIR="Olmo-3-7B-Think"
# Hugging Face repository for scripts/fetch_model.sh.
HF_REPO="allenai/Olmo-3-7B-Think"
HF_REVISION="d97e442d7cc678210054dbcc9b440894d62c89a4"
MODEL_NAME="olmo3-7b-think"

# 13.6 GiB of weights, 32 KV heads (~512 KB/token of KV cache):
# at most 20 GiB of weights per 40 GB card.
TENSOR_PARALLEL=1
GPUS=1

# A reasoning model: its chat template opens <think>.
MAX_NEW_TOKENS=1024

# Not measured.
EXACTLEARNER_BATCH_SIZE=32

WALLTIME="${WALLTIME:-24:00:00}"
MEMORY="128G"   # the standard; the Java heap is derived from it (run_experiment.sh)
