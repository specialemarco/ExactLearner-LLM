# Qwen3-4B-Thinking-2507.

MODEL_DIR=$(cd "$MODEL_ROOT" && echo hub/models--Qwen--Qwen3-4B-Thinking-2507/snapshots/*)
# Hugging Face repository for scripts/fetch_model.sh.
HF_REPO="Qwen/Qwen3-4B-Thinking-2507"
MODEL_NAME="qwen3-4b"

# ~7.5 GiB of weights and GQA (8 KV heads, ~150 KB/token) leave ~30 GiB of KV
# pool on one 40 GB card: no tensor parallelism needed.
TENSOR_PARALLEL=1
GPUS="a100:1"

# A reasoning model: its template opens <think>, as DeepSeek-R1's does, and a
# binding budget cuts the reasoning before the answer.
MAX_NEW_TOKENS=1024

# Not measured.
EXACTLEARNER_BATCH_SIZE=32

# A smoke-test default; a full run needs far longer.
WALLTIME="${WALLTIME:-00:20:00}"
MEMORY="64G"
JAVA_HEAP="24g"
