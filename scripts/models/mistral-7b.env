# Mistral-7B-Instruct-v0.3 

MODEL_DIR="models/mistral-7b-instruct-v0.3"
MODEL_NAME="mistral"
TENSOR_PARALLEL=1
GPUS="a100:1"
MAX_NEW_TOKENS=128
EXACTLEARNER_BATCH_SIZE=256

# A smoke-test hour, which is all this model has been run for. Overridable from
# the submitting environment for the same reason as in deepseek-r1-32b.env: how
# long a submission needs depends on how much of the budget is left, not on the
# weights. A real C1/C2/C3 run needs hours, so pass one:
#
#   WALLTIME=12:00:00 scripts/submit.sh mistral-7b owl2bench/c2-nlp-advanced resume=true
#
# Unset, this is exactly the 01:00:00 it has always been.
WALLTIME="${WALLTIME:-01:00:00}"
MEMORY="64G"
# 64G cannot hold the 64g default heap. Job 4094190 touched 15.0 GiB in total,
# so 24g is ~3x headroom; the 64g default is a 32B/TP=4 figure.
JAVA_HEAP="24g"
