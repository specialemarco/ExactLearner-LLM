# DeepSeek-R1-Distill-Qwen-14B -- the size point between mistral-7b and
# deepseek-r1-32b.
#
# Same distill family and same Qwen2 architecture as deepseek-r1-32b, so moving
# between the two varies parameter count and nothing else: same reasoning
# behaviour, same <think> block, same token budget. That is the point -- the
# runbook's "Making it fit" section argues the reasoning-vs-standard comparison
# is confounded by 4.5x the parameters, and this sits in the middle of that gap.

# The 32B pins its snapshot hash literally because HPC-RUNBOOK.md records it.
# This one is written down nowhere and differs per download, so read it from the
# hub's own ref rather than pin a guess. To pin it, run
#   cat $MODEL_ROOT/hub/models--deepseek-ai--DeepSeek-R1-Distill-Qwen-14B/refs/main
# and paste the hash in place of these two lines. Pinning becomes necessary if a
# re-download ever leaves two snapshots and you want the older one.
_repo="hub/models--deepseek-ai--DeepSeek-R1-Distill-Qwen-14B"
MODEL_DIR="$_repo/snapshots/$(cat "${MODEL_ROOT:-}/$_repo/refs/main" 2>/dev/null || true)"
[[ "$MODEL_DIR" == */snapshots/?* ]] ||
  die "cannot read ${MODEL_ROOT:-<MODEL_ROOT unset>}/$_repo/refs/main -- is the model downloaded, and is MODEL_ROOT right?"

MODEL_NAME="deepseek-r1-14b"

# TP=2, not 1. 14.8B of bf16 is ~29.6 GiB against the 33 GiB that --gpu-util 0.90
# leaves on an A100-PCIE-40GB, and CUDA graph capture takes a further 1-3 GiB, so
# TP=1 would run with a KV pool of a couple of GiB and thrash under a prewarm
# batch. TP=2 puts ~15 GiB of weights on each card and leaves ~18 GiB of KV each.
# 40 attention heads and 8 KV heads both divide by 2.
#
# This does reintroduce collectives, which TP=1 would have avoided entirely --
# see gotcha #18, the silent PCIe P2P hang. That is already handled the same way
# the 32B handles it, by NCCL_P2P_DISABLE=1 in run_experiment.sh, which is set
# unconditionally and is not optional.
TENSOR_PARALLEL=2
GPUS="a100:2"

# 1024, like the 32B and unlike mistral's 128: this is a reasoning model and the
# budget is not free to retune. At a 512 cap the measured p95 was 493 and a query
# that hits the cap silently flips True -> False. Watch at_cap, not truncated.
MAX_NEW_TOKENS=1024

# 16 is the only measured figure (32B, 8 CPU cores, 2.56 s/query at 162 tok/s
# aggregate). 32 here is an extrapolation, not a measurement: half the weights
# leave GPU headroom, but the 8 cores are shared with the server and gotcha #17
# is that a starved CPU throttles batching hardest. If the log's aggregate tok/s
# is no better than the 32B's, put this back to 16.
EXACTLEARNER_BATCH_SIZE=32

# Same 24 h as the 32B. Roughly twice its throughput does not make a C2 run fit
# either -- that needs resume=true and several jobs whatever the model.
WALLTIME="${WALLTIME:-24:00:00}"

# Between the 32B's 128G and mistral's 64G. vLLM's host side is the other half of
# this allocation and scales with weights and TP: ~50 GiB measured at 32B/TP=4,
# 15.0 GiB for the whole of job 4094190 at 7B/TP=1. 48g of heap leaves 48G for it,
# which is ample either way; the 64g default is a 32B/TP=4 figure and does not fit
# here.
MEMORY="96G"
JAVA_HEAP="48g"
