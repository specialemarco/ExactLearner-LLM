# DeepSeek-R1-Distill-Qwen-14B -- the size point between mistral-7b and
# deepseek-r1-32b, same distill family and architecture as the 32B.

# Hash not recorded anywhere, unlike the 32B's; read it rather than pin a guess.
_repo="hub/models--deepseek-ai--DeepSeek-R1-Distill-Qwen-14B"
MODEL_DIR="$_repo/snapshots/$(cat "${MODEL_ROOT:-}/$_repo/refs/main" 2>/dev/null || true)"
[[ "$MODEL_DIR" == */snapshots/?* ]] ||
  die "cannot read ${MODEL_ROOT:-<MODEL_ROOT unset>}/$_repo/refs/main -- is the model downloaded, and is MODEL_ROOT right?"

MODEL_NAME="deepseek-r1-14b"

# TP=1 would avoid collectives but ~29.6 GiB of weights leaves no KV pool on a
# 40 GB card. 40 attention heads and 8 KV heads both divide by 2.
TENSOR_PARALLEL=2
GPUS="a100:2"
MAX_NEW_TOKENS=1024

# Extrapolated, not measured -- 16 is the measured figure. Put it back if the
# aggregate tok/s is no better than the 32B's.
EXACTLEARNER_BATCH_SIZE=32

WALLTIME="${WALLTIME:-24:00:00}"
MEMORY="96G"
JAVA_HEAP="48g"
