# Your settings for scripts/submit.sh -- copy, do not edit in place:
#
#   cp scripts/experiment.env.example scripts/experiment.env
#
# This file is gitignored and holds only what is yours: where your weights live
# and which project pays. Everything about a *model* -- its directory, tensor
# parallelism, GPU count, token budget, batch size -- lives in a tracked file
# under scripts/models/, so we both run a model the same way.
#
#   scripts/submit.sh mistral-7b src/main/java/org/configurations/experiments/<config>.yml
#
# Sourced by bash: ordinary shell syntax, quote your paths.

# Parent of the model directories named by MODEL_DIR in scripts/models/*.env.
MODEL_ROOT="/cluster/work/projects/ecXX/YOURUSER"

# Slurm project to bill. Overrides the #SBATCH --account in run_experiment.sh.
SBATCH_ACCOUNT="ecXX"

# Extra sbatch flags, if your site needs them. Account and GPUs are already
# handled -- GPUs come from the model file, since they follow the model.
# SBATCH_EXTRA=(--partition=accel --time=24:00:00)

# --- rarely needed -----------------------------------------------------------
# MAX_MODEL_LEN=4096         # KV cache cap; prompts are ~50 tokens
# PORT=11434
# SERVER_READY_TIMEOUT=5400
# EXACTLEARNER_BATCH_DECOMPOSE=true
# EXACTLEARNER_BATCH_UNSATURATE=true
# EXACTLEARNER_RESUME=false  # DRAFT -- read the note in run_experiment.sh first
# EXACTLEARNER_SAMPLER_SEED=0
# JAVA_HEAP=64g
# JFR=1
