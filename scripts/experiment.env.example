# Personal settings for scripts/run_experiment.sh -- copy, do not edit in place:
#
#   cp scripts/experiment.env.example scripts/experiment.env
#   $EDITOR scripts/experiment.env
#
# scripts/experiment.env is gitignored, so your copy is never committed and you
# will not collide with a collaborator's paths. Keep this template in sync when
# you add a setting worth sharing.
#
# Sourced by bash: ordinary shell syntax, quote your paths. Plain assignment
# (VAR=x) always wins over the script's default; write VAR="${VAR:-x}" instead
# if you want to keep overriding it from the sbatch command line.

# =============================================================================
# REQUIRED
# =============================================================================

# Directory holding the model weights -- a HuggingFace snapshot directory, i.e.
# the one containing config.json and the *.safetensors shards.
MODEL_PATH="/cluster/work/projects/ecXX/YOURUSER/hub/models--deepseek-ai--DeepSeek-R1-Distill-Qwen-32B/snapshots/CHANGEME"

# =============================================================================
# SLURM SUBMISSION -- used by scripts/submit.sh, not by run_experiment.sh
# =============================================================================
# sbatch parses the #SBATCH directives inside run_experiment.sh before the
# script executes, so nothing sourced here can change them. Command-line flags
# DO override them, which is what scripts/submit.sh exists to do: it reads this
# array and passes it on the sbatch line.
#
#   scripts/submit.sh src/main/java/org/configurations/experiments/<config>.yml
#
# Plain `sbatch scripts/run_experiment.sh ...` still works; you just get the
# script's built-in defaults (account ec30) instead of these.
SBATCH_ARGS=(
  --account=ecXX
  # --partition=accel
  # --time=24:00:00
  # --gpus-per-node=a100:4
)

# =============================================================================
# OPTIONAL -- the defaults below are what run_experiment.sh already uses
# =============================================================================

# Project-local EasyBuild tree. The default points at ec30's; set your own, or
# empty to use only cluster-wide modules.
# EXTRA_MODULEPATH="/fp/projects01/ecXX/software/easybuild/modules/all/"

# Override the whole module list only if your site names them differently.
# These must share one Python generation -- see the note in run_experiment.sh.
# PYTHON_MODULES=(
#   "nlpl-pytorch/2.6.0-foss-2024a-cuda-12.6.0-Python-3.12.3"
#   "nlpl-accelerate/1.9.0-foss-2024a-Python-3.12.3"
#   "Transformers/4.57.1-gfbf-2024a"
#   "nlpl-vllm/0.8.2-foss-2024a-Python-3.12.3"
# )

# --- model server ------------------------------------------------------------
# MAX_NEW_TOKENS=1024        # reasoning budget; see the warning in the script
# TENSOR_PARALLEL=4          # must equal the GPU count and divide the head count
# MAX_MODEL_LEN=4096
# PORT=11434
# SERVER_READY_TIMEOUT=5400

# --- learner -----------------------------------------------------------------
# EXACTLEARNER_BATCH_SIZE=16
# EXACTLEARNER_BATCH_DECOMPOSE=true
# EXACTLEARNER_BATCH_UNSATURATE=true
# EXACTLEARNER_RESUME=false  # DRAFT -- read the note in run_experiment.sh first
# EXACTLEARNER_SAMPLER_SEED=0

# --- JVM ---------------------------------------------------------------------
# JAVA_HEAP=64g
# JFR=1
# PARALLEL_GC_THREADS=4
