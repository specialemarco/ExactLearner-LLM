													<ns1:Restriction>
														<ns1:onProperty rdf:resource="http://www.co-ode.org/ontologies/galen#hasUniqueAssociatedDisplacement" />
														<ns1:someValuesFrom>
															<ns1:Class>
																<ns1:intersectionOf rdf:parseType="Collection">
																	<rdf:Description rdf:about="http://www.co-ode.org/ontologies/galen#Displacement" />
																	<ns1:Restriction>
																		<ns1:onProperty rdf:resource="http://www.co-ode.org/ontologies/galen#isDisplacementFrom" />
																		<ns1:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/galen#OroPharynx" />
																	</ns1:Restriction>
																</ns1:intersectionOf>
															</ns1:Class>
														</ns1:someValuesFrom>
													</ns1:Restriction>
												</ns1:intersectionOf>
											</ns1:Class>
										</ns1:someValuesFrom>
									</ns1:Restriction>
								</ns1:intersectionOf>
							</ns1:Class>
						</ns1:someValuesFrom>
					</ns1:Restriction>
				</ns1:intersectionOf>
			</ns1:Class>
		</ns1:equivalentClass>
