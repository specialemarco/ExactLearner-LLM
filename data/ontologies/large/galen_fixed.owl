	<ns1:Class rdf:about="http://www.co-ode.org/ontologies/galen#pH">
		<ns1:equivalentClass>
			<ns1:Class>
				<ns1:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="http://www.co-ode.org/ontologies/galen#Concentration" />
					<ns1:Restriction>
						<ns1:onProperty rdf:resource="http://www.co-ode.org/ontologies/galen#isConcentrationOf" />
						<ns1:someValuesFrom>
							<ns1:Class>
								<ns1:intersectionOf rdf:parseType="Collection">
									<rdf:Description rdf:about="http://www.co-ode.org/ontologies/galen#Hydrogen" />
									<ns1:Restriction>
										<ns1:onProperty rdf:resource="http://www.co-ode.org/ontologies/galen#hasIonisationFeature" />
										<ns1:someValuesFrom>
											<ns1:Class>
												<ns1:intersectionOf rdf:parseType="Collection">
													<rdf:Description rdf:about="http://www.co-ode.org/ontologies/galen#IonisationFeature" />
													<ns1:Restriction>
														<ns1:onProperty rdf:resource="http://www.co-ode.org/ontologies/galen#hasAbsoluteState" />
														<ns1:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/galen#ionic" />
													</ns1:Restriction>
												</ns1:intersectionOf>
											</ns1:Class>
										</ns1:someValuesFrom>
									</ns1:Restriction>
									<ns1:Restriction>
										<ns1:onProperty rdf:resource="http://www.co-ode.org/ontologies/galen#isDissolvedWithin" />
										<ns1:someValuesFrom>
											<ns1:Class>
												<ns1:intersectionOf rdf:parseType="Collection">
													<rdf:Description rdf:about="http://www.co-ode.org/ontologies/galen#Substance" />
													<ns1:Restriction>
														<ns1:onProperty rdf:resource="http://www.co-ode.org/ontologies/galen#hasPhysicalState" />
														<ns1:someValuesFrom>
															<ns1:Class>
																<ns1:intersectionOf rdf:parseType="Collection">
																	<rdf:Description rdf:about="http://www.co-ode.org/ontologies/galen#PhysicalState" />
																	<ns1:Restriction>
																		<ns1:onProperty rdf:resource="http://www.co-ode.org/ontologies/galen#hasAbsoluteState" />
																		<ns1:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/galen#liquid" />
																	</ns1:Restriction>
																</ns1:intersectionOf>
															</ns1:Class>
														</ns1:someValuesFrom>
													</ns1:Restriction>
												</ns1:intersectionOf>
											</ns1:Class>
										</ns1:someValuesFrom>
									</ns1:Restriction>
								</ns1:intersectionOf>
							</ns1:Class>
						</ns1:someValuesFrom>
					</ns1:Restriction>
				</ns1:intersectionOf>
			</ns1:Class>
		</ns1:equivalentClass>
		<ns2:subClassOf rdf:resource="http://www.co-ode.org/ontologies/galen#Concentration" />
		<ns3:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pH</ns3:prefixIRI>
		<ns2:label>pH</ns2:label>
	</ns1:Class>
