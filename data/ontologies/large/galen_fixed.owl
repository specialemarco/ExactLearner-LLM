	<ns1:Class rdf:about="http://www.co-ode.org/ontologies/galen#MicroPenis">
		<ns1:equivalentClass>
			<ns1:Class>
				<ns1:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="http://www.co-ode.org/ontologies/galen#Size" />
					<ns1:Restriction>
						<ns1:onProperty rdf:resource="http://www.co-ode.org/ontologies/galen#hasQuantity" />
						<ns1:someValuesFrom>
							<ns1:Class>
								<ns1:intersectionOf rdf:parseType="Collection">
									<rdf:Description rdf:about="http://www.co-ode.org/ontologies/galen#Level" />
									<ns1:Restriction>
										<ns1:onProperty rdf:resource="http://www.co-ode.org/ontologies/galen#hasMagnitude" />
										<ns1:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/galen#veryLowLevel" />
									</ns1:Restriction>
								</ns1:intersectionOf>
							</ns1:Class>
						</ns1:someValuesFrom>
					</ns1:Restriction>
					<ns1:Restriction>
						<ns1:onProperty rdf:resource="http://www.co-ode.org/ontologies/galen#isSizeOf" />
						<ns1:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/galen#Penis" />
					</ns1:Restriction>
				</ns1:intersectionOf>
			</ns1:Class>
		</ns1:equivalentClass>
		<ns2:subClassOf rdf:resource="http://www.co-ode.org/ontologies/galen#Size" />
		<ns2:subClassOf>
			<ns1:Restriction>
				<ns1:onProperty rdf:resource="http://www.co-ode.org/ontologies/galen#hasAcquisitionMode" />
				<ns1:someValuesFrom>
					<ns1:Class>
						<ns1:intersectionOf rdf:parseType="Collection">
							<rdf:Description rdf:about="http://www.co-ode.org/ontologies/galen#AcquisitionMode" />
							<ns1:Restriction>
								<ns1:onProperty rdf:resource="http://www.co-ode.org/ontologies/galen#hasAbsoluteState" />
								<ns1:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/galen#congenital" />
							</ns1:Restriction>
						</ns1:intersectionOf>
					</ns1:Class>
				</ns1:someValuesFrom>
			</ns1:Restriction>
		</ns2:subClassOf>
