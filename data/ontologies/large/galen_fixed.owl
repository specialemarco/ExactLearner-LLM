	<ns1:Class rdf:about="http://www.co-ode.org/ontologies/galen#OroPharyngealPain">
		<ns1:equivalentClass>
			<ns1:Class>
				<ns1:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="http://www.co-ode.org/ontologies/galen#ExternalStimulusSensation" />
					<ns1:Restriction>
						<ns1:onProperty rdf:resource="http://www.co-ode.org/ontologies/galen#actsOn" />
						<ns1:someValuesFrom>
							<ns1:Class>
								<ns1:intersectionOf rdf:parseType="Collection">
									<rdf:Description rdf:about="http://www.co-ode.org/ontologies/galen#PainSignal" />
									<ns1:Restriction>
										<ns1:onProperty rdf:resource="http://www.co-ode.org/ontologies/galen#isConsequenceOf" />
										<ns1:someValuesFrom>
											<ns1:Class>
												<ns1:intersectionOf rdf:parseType="Collection">
