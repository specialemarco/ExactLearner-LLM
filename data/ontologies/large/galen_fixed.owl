	<ns1:Class rdf:about="http://www.co-ode.org/ontologies/galen#nonCorrosive">
		<ns1:equivalentClass>
			<ns1:Class>
				<ns1:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="http://www.co-ode.org/ontologies/galen#Corrosiveness" />
					<ns1:Restriction>
						<ns1:onProperty rdf:resource="http://www.co-ode.org/ontologies/galen#hasQuantity" />
						<ns1:someValuesFrom>
							<ns1:Class>
								<ns1:intersectionOf rdf:parseType="Collection">
									<rdf:Description rdf:about="http://www.co-ode.org/ontologies/galen#Level" />
									<ns1:Restriction>
										<ns1:onProperty rdf:resource="http://www.co-ode.org/ontologies/galen#hasMagnitude" />
										<ns1:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/galen#lowLevel" />
									</ns1:Restriction>
								</ns1:intersectionOf>
							</ns1:Class>
						</ns1:someValuesFrom>
					</ns1:Restriction>
				</ns1:intersectionOf>
			</ns1:Class>
		</ns1:equivalentClass>
		<ns2:subClassOf rdf:resource="http://www.co-ode.org/ontologies/galen#Corrosiveness" />
		<ns3:prefixIRI rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nonCorrosive</ns3:prefixIRI>
		<ns2:label>non Corrosive</ns2:label>
	</ns1:Class>
