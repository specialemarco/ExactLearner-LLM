	<ns1:Class rdf:about="http://www.co-ode.org/ontologies/galen#TCellDiffuseMixedCellLymphoma">
		<ns1:equivalentClass>
			<ns1:Class>
				<ns1:intersectionOf rdf:parseType="Collection">
					<rdf:Description rdf:about="http://www.co-ode.org/ontologies/galen#DiffuseMixedCleavedCellLymphoma" />
					<ns1:Restriction>
						<ns1:onProperty rdf:resource="http://www.co-ode.org/ontologies/galen#hasUniqueAssociatedProcess" />
						<ns1:someValuesFrom>
							<ns1:Class>
								<ns1:intersectionOf rdf:parseType="Collection">
									<rdf:Description rdf:about="http://www.co-ode.org/ontologies/galen#MalignantNeoplasticProcess" />
									<ns1:Restriction>
										<ns1:onProperty rdf:resource="http://www.co-ode.org/ontologies/galen#actsSpecificallyOn" />
										<ns1:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/galen#TCellLymphocyte" />
									</ns1:Restriction>
								</ns1:intersectionOf>
							</ns1:Class>
						</ns1:someValuesFrom>
					</ns1:Restriction>
				</ns1:intersectionOf>
			</ns1:Class>
		</ns1:equivalentClass>
