			<ns1:Restriction>
				<ns1:onProperty rdf:resource="http://www.co-ode.org/ontologies/galen#hasPathologicalStatus" />
				<ns1:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/galen#pathological" />
			</ns1:Restriction>
		</ns2:subClassOf>
